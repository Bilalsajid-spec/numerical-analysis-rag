# Purpose: document the local settings the project will need without exposing secrets.
# Work: configure local model threads, port, and retrieval threshold.

# All inference is local; no paid API key is required.
LLM_PORT=8765
# Start with six CPU threads; additional threads may not improve performance.
LLM_THREADS=6
# Validate retrieval similarity cutoff changes using the included evaluation.
MIN_SIMILARITY=0.32

# Set the frontend backend URL in PowerShell before launching Streamlit,
# or use the default localhost:8000. The frontend does not load .env itself.
# $env:RAG_API_URL="http://127.0.0.1:8000"
